# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Dashboard > Project Settings > API)
SUPABASE_URL=

# Secret key (sb_secret_...). SERVER ONLY. Bypasses RLS. Never expose it.
# Create/rotate in Dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Shared-password gate for the whole app (HTTP Basic Auth).
APP_USERNAME=admin
APP_PASSWORD=local
